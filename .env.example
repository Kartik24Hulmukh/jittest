# Pick ONE provider. jittest uses LiteLLM, so any of ~100 providers works.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Model id in LiteLLM format. Browse ids at https://models.litellm.ai/
JITTEST_MODEL=anthropic/claude-sonnet-4-5

# Hard USD cap per run. Enforced mid-loop, not after the bill arrives.
JITTEST_BUDGET_USD=1.00

# Minimum Diff Risk Score before a changed symbol is attacked (0-1).
# Raise this to spend less and comment less. Lower it only with evidence.
JITTEST_RISK_THRESHOLD=0.35

# Local corpus of every candidate and its outcome. Never uploaded automatically.
JITTEST_LEDGER=.jittest/ledger.db
